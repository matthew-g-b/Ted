<Window x:Class="TED.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TED.Controls"
        Title="TED | Engine Visualization" Width="1510" Height="940" MinWidth="1170" MinHeight="740"
        Background="#0E1012" Foreground="#FFFFFF" FontFamily="Consolas"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Frame" TargetType="Border">
            <Setter Property="BorderBrush" Value="#8A8D90" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0E1012" />
        </Style>
        <Style x:Key="PanelHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="9,3,7,2" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B2B7BA" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Background" Value="#24282B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#A9ABAC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Margin" Value="0,0,5,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#101214" />
            <Setter Property="BorderBrush" Value="#838789" />
            <Setter Property="Padding" Value="3,3" />
        </Style>
        <Style x:Key="GaugeCell" TargetType="Border" BasedOn="{StaticResource Frame}">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>
    <!-- Full-screen 3-column organization mirrors the C++ Engine Simulator's screen 0 layout.
         Native WPF graphics; no third-party component library. -->
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.05*" />
            <ColumnDefinition Width="3.8*" />
            <ColumnDefinition Width="3.05*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: information, controls, performance and raw diagnostic log -->
        <Grid Grid.Column="0" Margin="0,0,3,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="145" />
                <RowDefinition Height="121" />
                <RowDefinition Height="142" />
                <RowDefinition Height="112" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Frame}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#8A8D90" BorderThickness="0,0,0,1">
                        <StackPanel Margin="12,10,0,2">
                            <TextBlock Text="TED" FontSize="31" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="TOYOTA ENHANCED DIAGNOSTICS" FontSize="11" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="#8A8D90" BorderThickness="0,0,0,1">
                        <DockPanel Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="2ZR-FAE | INLINE 4 | 1.8 L" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.Row="2" Margin="10,6,0,0" Text="BUILD 0.2 / LIVE DIAGNOSTICS / CAN 500K"
                               Style="{StaticResource Small}" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Frame}">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="31"/><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CONNECTION / READING" Style="{StaticResource PanelHeading}" Margin="0"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="PORT" Width="50" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox x:Name="PortBox" Text="COM5" Width="67" Height="25" Margin="0,0,7,0" />
                        <Button x:Name="ConnectButton" Content="CONNECT" Click="Connect_Click" />
                        <Button x:Name="DisconnectButton" Content="CLOSE" IsEnabled="False" Click="Disconnect_Click" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="START POLLING" IsEnabled="False" Click="Start_Click" />
                        <Button x:Name="StopButton" Content="STOP" IsEnabled="False" Click="Stop_Click" />
                        <TextBlock Text="1 PASS / ~1.2s" FontSize="10" Foreground="#92999C"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" x:Name="ConnectionState" Text="DISCONNECTED" FontSize="11" Foreground="#77CEE0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Frame}">
                <Grid Margin="9,5">
                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="PERFORMANCE / ECU" Style="{StaticResource PanelHeading}" Margin="0" />
                    <DockPanel Grid.Row="1"><TextBlock Text="ENGINE ECU" /><TextBlock Text="7E0  /  7E8" HorizontalAlignment="Right" DockPanel.Dock="Right" Foreground="#77CEE0" /></DockPanel>
                    <DockPanel Grid.Row="2"><TextBlock Text="SERIAL LINK" /><TextBlock x:Name="FirmwareStatus" Text="NOT CONNECTED" Foreground="#77CEE0" DockPanel.Dock="Right" /></DockPanel>
                    <DockPanel Grid.Row="3"><TextBlock Text="LAST SAMPLE" /><TextBlock x:Name="LastSampleStatus" Text="NONE" Foreground="#77CEE0" DockPanel.Dock="Right" /></DockPanel>
                    <DockPanel Grid.Row="4"><TextBlock Text="SPARK ADVANCE" /><TextBlock x:Name="SparkStatus" Text="--" Foreground="#77CEE0" DockPanel.Dock="Right" /></DockPanel>
                </Grid>
            </Border>
            <Border Grid.Row="3" Style="{StaticResource Frame}">
                <Grid Margin="9,5">
                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TRANSMISSION" Style="{StaticResource PanelHeading}" Margin="0"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="CVT RATIO" FontSize="12"/>
                            <TextBlock Text="N/A" FontSize="30" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="NO VERIFIED PID" Foreground="#B0B4B7" FontSize="11"/>
                            <TextBlock Text="PULLEY SPEEDS: N/A" Foreground="#B0B4B7" FontSize="10" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource Frame}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="DIAGNOSTIC COMMUNICATION" Style="{StaticResource PanelHeading}"/>
                    <TextBox Grid.Row="1" x:Name="LogBox" Margin="4" IsReadOnly="True" AcceptsReturn="True"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" FontSize="10" />
                    <TextBlock Grid.Row="2" x:Name="LastReading" Text="WAITING FOR LIVE ECU DATA" Style="{StaticResource Small}"
                               Margin="8,7" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MIDDLE: engine cross-section over scopes, like engine-sim screen zero -->
        <Grid Grid.Column="1" Margin="0,0,3,0">
            <Grid.RowDefinitions><RowDefinition Height="55*"/><RowDefinition Height="45*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Frame}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
                    <Border BorderBrush="#8A8D90" BorderThickness="0,0,0,1">
                        <DockPanel><TextBlock Style="{StaticResource PanelHeading}" Text="ENGINE VISUALIZATION" />
                            <TextBlock Text="2ZR-FAE" HorizontalAlignment="Right" Foreground="#77CEE0" Margin="10,9" DockPanel.Dock="Right" />
                        </DockPanel>
                    </Border>
                    <controls:InlineFourView x:Name="MotorView" Grid.Row="1" Margin="6,3" />
                    <TextBlock Grid.Row="2" Text="MODEL / RPM-DRIVEN / PHASE IS NOT MEASURED" FontSize="10"
                               Foreground="#9BA0A4" Margin="10,7" />
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="43*"/><RowDefinition Height="57*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Frame}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PanelHeading}" Text="WAVEFORM / ENGINE SPEED" />
                        <controls:TelemetryScope Grid.Row="1" x:Name="RpmScope" LowerBound="0" UpperBound="7000" WindowSeconds="180" Margin="4,2"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Frame}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PanelHeading}" Text="VEHICLE SPEED" FontSize="11" />
                            <controls:TelemetryScope Grid.Row="1" x:Name="SpeedScope" LowerBound="0" UpperBound="160" Margin="3,1" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Frame}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PanelHeading}" Text="CVT TEMPS *" FontSize="11" />
                            <controls:TelemetryScope Grid.Row="1" x:Name="CvtScope" LowerBound="0" UpperBound="160" Margin="3,1" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Frame}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PanelHeading}" Text="INTAKE AIR / MAF" FontSize="11" />
                            <controls:TelemetryScope Grid.Row="1" x:Name="MafScope" LowerBound="0" UpperBound="140" Margin="3,1" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Frame}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PanelHeading}" Text="ENGINE LOAD" FontSize="11" />
                            <controls:TelemetryScope Grid.Row="1" x:Name="LoadScope" LowerBound="0" UpperBound="100" Margin="3,1" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- RIGHT: dense analogue gauge cluster, 2 wide x 5 tall. -->
        <UniformGrid Grid.Column="2" Columns="2" Rows="5">
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="ENGINE SPEED" FontSize="12"/>
                <controls:EngineSimGauge x:Name="RpmGauge" Grid.Row="1" Minimum="0" Maximum="7000" Unit="RPM" />
            </Grid></Border>
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="VEHICLE SPEED" FontSize="12"/>
                <controls:EngineSimGauge x:Name="SpeedGauge" Grid.Row="1" Minimum="0" Maximum="160" Unit="km/h"/>
            </Grid></Border>
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="MANIFOLD PRESS." FontSize="12"/>
                <controls:EngineSimGauge x:Name="MapGauge" Grid.Row="1" Minimum="0" Maximum="120" Unit="kPa"/>
            </Grid></Border>
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="ENGINE LOAD" FontSize="12"/>
                <controls:EngineSimGauge x:Name="LoadGauge" Grid.Row="1" Minimum="0" Maximum="100" Unit="%" Format="F1"/>
            </Grid></Border>
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="AIR FLOW" FontSize="12"/>
                <controls:EngineSimGauge x:Name="MafGauge" Grid.Row="1" Minimum="0" Maximum="140" Unit="g/s" Format="F1"/>
            </Grid></Border>
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="THROTTLE" FontSize="12"/>
                <controls:EngineSimGauge x:Name="ThrottleGauge" Grid.Row="1" Minimum="0" Maximum="100" Unit="%" Format="F1"/>
            </Grid></Border>
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="COOLANT TEMP." FontSize="12"/>
                <controls:EngineSimGauge x:Name="CoolantGauge" Grid.Row="1" Minimum="-40" Maximum="140" Unit="°C" Format="F1"/>
            </Grid></Border>
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="INTAKE TEMP." FontSize="12"/>
                <controls:EngineSimGauge x:Name="IntakeGauge" Grid.Row="1" Minimum="-40" Maximum="100" Unit="°C" Format="F1"/>
            </Grid></Border>
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="CVT PAN TEMP *" FontSize="12"/>
                <controls:EngineSimGauge x:Name="PanGauge" Grid.Row="1" Minimum="0" Maximum="160" Unit="°C" Format="F1"/>
            </Grid></Border>
            <Border Style="{StaticResource GaugeCell}"><Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelHeading}" Text="CONVERTER TEMP *" FontSize="12"/>
                <controls:EngineSimGauge x:Name="ConverterGauge" Grid.Row="1" Minimum="0" Maximum="160" Unit="°C" Format="F1"/>
            </Grid></Border>
        </UniformGrid>
    </Grid>
</Window>
